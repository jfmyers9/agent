{
  "defaultProvider": "openai",
  "theme": "dark",
  "defaultThinkingLevel": "high",
  "defaultModel": "gpt-6.1-sol",
  "enabledModels": [
    "openai/gpt-6-astra",
    "openai/gpt-6-luna",
    "openai/gpt-6-sol",
    "openai/gpt-6.1-sol",
    "openai/gpt-5.6-luna",
    "openai/gpt-5.6-terra",
    "openai/gpt-5.6-sol",
    "openai/gpt-5.5",
    "openai/gpt-5.4",
    "openai/gpt-5.4-mini",
    "openai-codex/gpt-6-astra",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6-sol",
    "openai-codex/gpt-6.1-sol",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-terra",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.5",
    "openai-codex/gpt-5.4",
    "openai-codex/gpt-5.4-mini",
    "deepseek/*",
    "anthropic/claude-opus-5",
    "anthropic/claude-opus-4-8",
    "anthropic/claude-sonnet-4-6",
    "anthropic/claude-haiku-4-5"
  ],
  "skills": [
    "skills"
  ],
  "enableSkillCommands": true,
  "steeringMode": "all",
  "autoUpdate": true,
  "transport": "auto",
  "doubleEscapeAction": "tree",
  "treeFilterMode": "default",
  "quietStartup": true,
  "hideThinkingBlock": false,
  "editorPaddingX": 0,
  "terminal": {
    "clearOnShrink": false,
    "showTerminalProgress": true
  },
  "lastChangelogVersion": "1.0.3",
  "packages": [
    "npm:@dreki-gg/pi-context7@0.2.0"
  ],
  "extensions": [
    "extensions/runtime-support/index.ts",
    "extensions/collapse-transcript/index.ts",
    "extensions/fireworks-gateway.ts",
    "extensions/agents-local/index.ts",
    "extensions/auto-compact-resume/index.ts",
    "extensions/fileops/index.ts",
    "extensions/apply-patch/index.ts",
    "extensions/vcc/index.ts",
    "extensions/pretty/index.ts",
    "extensions/context-guard/index.ts",
    "extensions/exec-command/index.ts",
    "extensions/ask/index.ts",
    "extensions/async-questions/index.ts",
    "extensions/clear.ts",
    "extensions/diff-prod/index.ts",
    "extensions/tuicr.ts",
    "extensions/effort.ts",
    "extensions/fast-mode.ts",
    "extensions/prompt-storage/index.ts",
    "extensions/vim/index.ts",
    "extensions/skillful/index.ts",
    "extensions/token-burden/index.ts",
    "extensions/system-prompt/index.ts",
    "extensions/convergence-loop/index.ts",
    "extensions/tui/index.ts",
    "extensions/spawn/index.ts",
    "extensions/fork-split.ts",
    "extensions/subagents/index.ts"
  ],
  "defaultTools": [
    "+codemode",
    "+tool_search",
    "+request_user_input_async"
  ],
  "codemode": {
    "mode": "only"
  }
}