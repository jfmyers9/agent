+// Pi's uncached extension imports can expose partially evaluated modules when
+// sibling sessions reload resources together. Serialize discovery, not agent work.
+const resourceLoadQueueKey = Symbol.for("agent-config.subagents.resource-load-queue.v1");
+const resourceLoadQueue = globalThis as typeof globalThis & { [resourceLoadQueueKey]?: Promise<void> };
+
+async function reloadChildResources(loader: DefaultResourceLoader): Promise<void> {
+	const next = (resourceLoadQueue[resourceLoadQueueKey] ?? Promise.resolve()).then(() => loader.reload());
+	resourceLoadQueue[resourceLoadQueueKey] = next.then(() => undefined, () => undefined);
+	await next;
