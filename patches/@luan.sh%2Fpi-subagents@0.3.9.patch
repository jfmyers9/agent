+function modelCost(
+	usage: Usage,
+	provider: string,
+	modelId: string,
+	responseModel: string | undefined,
+	registry?: Registry,
+): number {
+	// Provider totals preserve request-time pricing and service-tier multipliers.
+	if (Number.isFinite(usage.cost?.total) && usage.cost.total >= 0) return usage.cost.total;
+	const requested = registry?.find(provider, modelId);
+	const fallback = (requested?.compat as AnthropicMessagesCompat | undefined)?.allowedFallbackModels?.find(
+		(model) => model.provider === provider && model.model === responseModel,
+	);
+	const model =
+		(responseModel && registry?.find(provider, responseModel)) ||
+		(requested && fallback ? { ...requested, cost: fallback.cost } : requested);
+	if (!model) return reportedCost(usage);
+	// calculateCost mutates usage.cost; never rewrite persisted provider telemetry.
+	const cost = calculateCost(model, { ...usage, cost: { ...usage.cost } }).total;
+	return Number.isFinite(cost) && cost >= 0 ? cost : reportedCost(usage);
+}
+
+export function entryCost(entry: SessionEntry, registry?: Registry): number {
+	if (entry.type === "usage") return modelCost(entry.usage, entry.provider, entry.model, undefined, registry);
+	if (entry.type === "compaction" || entry.type === "branch_summary") return reportedCost(entry.usage);
+	if (entry.type !== "message") return 0;
+	const message = entry.message;
+	if (message.role === "assistant")
+		return modelCost(message.usage, message.provider, message.model, message.responseModel, registry);
+	return message.role === "toolResult" ? reportedCost(message.usage) : 0;
+}
+
+/** Charge each persisted entry once, excluding history copied into a new child runtime. */
+export class SessionCostLedger {
+	private readonly seen: Set<string>;
+	lastEntryId: string | null;
+	constructor(
+		entries: readonly SessionEntry[],
+		private readonly registry?: Registry,
+	) {
+		this.seen = new Set(entries.map((entry) => entry.id));
+		this.lastEntryId = entries.at(-1)?.id ?? null;
+	}
+	collect(entries: readonly SessionEntry[]): number {
+		let cost = 0;
+		for (const entry of entries) {
+			if (this.seen.has(entry.id)) continue;
+			this.seen.add(entry.id);
+			cost += entryCost(entry, this.registry);
+		}
+		this.lastEntryId = entries.at(-1)?.id ?? null;
+		return cost;
+	}
 }
 
